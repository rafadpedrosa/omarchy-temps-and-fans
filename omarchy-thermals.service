[Unit]
Description=Minimal direct hwmon fan controller for Omarchy Thermals
After=systemd-modules-load.service
Conflicts=coolercontrold.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/omarchy-thermalsd --config /etc/omarchy-thermals/config.json
Restart=on-failure
RestartSec=2
RuntimeDirectory=omarchy-thermals
StateDirectory=omarchy-thermals
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/sys /var/lib/omarchy-thermals /run/omarchy-thermals
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
